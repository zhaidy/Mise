rules_version = '2';

// 共享厨房的权限：贴到 Firebase 控制台 → Firestore Database → 规则
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(code) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/kitchens/$(code)).data.members;
    }

    match /kitchens/{code} {
      // 只有成员能看厨房；不能列出所有厨房
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      // 新建时成员只有自己
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'createdAt'])
        && request.resource.data.members == [request.auth.uid];
      // 知道邀请码的人只能把自己加进 members
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() <= resource.data.members.size() + 1
        && request.resource.data.members.size() <= 10
        && request.auth.uid in request.resource.data.members;

      // 菜谱等数据：成员可读写
      match /{document=**} {
        allow read, write: if isMember(code);
      }
    }
  }
}
